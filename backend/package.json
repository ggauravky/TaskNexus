{
    "name": "tasknexus-backend",
    "version": "1.0.0",
    "description": "TaskNexus - Managed Task Outsourcing Platform Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "lint": "eslint . --ext .js --max-warnings 0",
        "validate:migrations": "node scripts/validateMigrations.js",
        "provision:admin": "node scripts/createAdmin.js",
        "test": "jest --runInBand",
