# Server Configuration
NODE_ENV=development
PORT=5000

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Controlled administrator provisioning (used only by npm run provision:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=TaskNexus
ADMIN_LAST_NAME=Administrator
# Dev only: when Supabase DNS/network is unavailable, allow local file-store fallback
DISABLE_LOCAL_AUTH_FALLBACK=false

# CORS
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://tasknexus.vercel.app
REFRESH_COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Platform Settings
PLATFORM_COMMISSION_PERCENTAGE=15
DEFAULT_REVISION_LIMIT=2
QA_REVIEW_SLA_HOURS=12
DISPUTE_RESOLUTION_SLA_HOURS=48

# Brevo Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@tasknexus.com
BREVO_SENDER_NAME=TaskNexus
BREVO_REPLY_TO_EMAIL=support@tasknexus.com
BREVO_ADMIN_NOTIFICATION_EMAIL=support@tasknexus.com
BREVO_NEWSLETTER_LIST_ID=

# Logging
LOG_LEVEL=info
