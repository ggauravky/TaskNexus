# Server Configuration
NODE_ENV=development
APP_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
API_BODY_LIMIT_BYTES=1048576

# MongoDB Atlas (use a dedicated least-privilege application user)
MONGODB_URI=
MONGODB_DB_NAME=tasknexus_v2
# Optional: DNS servers for Atlas SRV lookups (e.g. 8.8.8.8, 1.1.1.1). Recommended if host resolver fails SRV lookups.
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Controlled administrator provisioning (used only by npm run provision:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=TaskNexus
ADMIN_LAST_NAME=Administrator
# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://task-nexus-official.vercel.app
REFRESH_COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_REFRESH_MAX_REQUESTS=30
ADMIN_MUTATION_MAX_PER_HOUR=120

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_STORAGE_MODE=local
UPLOAD_PATH=./uploads
GRIDFS_BUCKET_NAME=tasknexus_attachments_development

# Platform Settings
PLATFORM_COMMISSION_PERCENTAGE=15
DEFAULT_REVISION_LIMIT=2
QA_REVIEW_SLA_HOURS=12
DISPUTE_RESOLUTION_SLA_HOURS=48

# Email delivery: Nodemailer -> Brevo SMTP. Never commit real credentials.
EMAIL_ENABLED=false
EMAIL_APP_NAME=TaskNexus
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=<BREVO_SMTP_LOGIN>
BREVO_SMTP_PASS=<BREVO_SMTP_PASSWORD>
BREVO_SENDER_EMAIL=<VERIFIED_SENDER_EMAIL>
BREVO_SENDER_NAME=TaskNexus
BREVO_REPLY_TO_EMAIL=<OPTIONAL_REPLY_TO_EMAIL>
BREVO_REPLY_TO_NAME=TaskNexus Support
EMAIL_APP_URL=https://task-nexus-official.vercel.app
EMAIL_SUPPORT_URL=https://task-nexus-official.vercel.app
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=1000
BREVO_ADMIN_NOTIFICATION_EMAIL=<OPTIONAL_ADMIN_EMAIL>

# Optional Brevo contact-list sync; not used for email delivery.
BREVO_CONTACTS_API_KEY=<OPTIONAL_BREVO_CONTACTS_API_KEY>
BREVO_NEWSLETTER_LIST_ID=

# Logging
LOG_LEVEL=info
