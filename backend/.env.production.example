NODE_ENV=production
APP_ENV=production
PORT=10000
APP_ORIGIN=https://tasknexus.vercel.app
ALLOWED_ORIGINS=https://tasknexus.vercel.app
TRUST_PROXY_HOPS=1
API_BODY_LIMIT_BYTES=1048576

# Use a dedicated production Atlas project/user/database. Never reuse tasknexus_v2.
MONGODB_URI=
MONGODB_DB_NAME=tasknexus_production
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# Generate independent values with at least 32 random characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
REFRESH_COOKIE_MAX_AGE_MS=604800000
REFRESH_COOKIE_SAME_SITE=none
BCRYPT_SALT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_REFRESH_MAX_REQUESTS=30
ADMIN_MUTATION_MAX_PER_HOUR=120
GITHUB_VERIFICATION_MAX_REQUESTS=20

# Ephemeral local uploads are deliberately blocked in production.
UPLOAD_STORAGE_MODE=disabled

EMAIL_DELIVERY_MODE=required
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TaskNexus
BREVO_REPLY_TO_EMAIL=
BREVO_ADMIN_NOTIFICATION_EMAIL=
BREVO_NEWSLETTER_LIST_ID=
BREVO_TIMEOUT_SECONDS=10
BREVO_MAX_RETRIES=2

LOG_LEVEL=info
